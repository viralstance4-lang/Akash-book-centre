PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookstore
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: enables HMAC signature verification on the /payments/webhook route.
# Set to the "Secret" shown when you create the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
CORS_ORIGIN=http://localhost:5173
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password

# ── Store location & delivery distance ────────────────────────────────────────
# Fixed store address used as the origin for delivery-distance calculation.
STORE_ADDRESS=3026/5A, Ranjeet Nagar, Hanuman Chowk, Near Hanuman Mandir & Shiv Chowk, South Patel Nagar, New Delhi – 110008
STORE_LATITUDE=28.646457
STORE_LONGITUDE=77.158939
# Optional: enables Google Distance Matrix API for delivery-distance calculation.
# Leave unset to use the free Haversine (straight-line) formula instead.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Production / Render ─────────────────────────────────────────────────────────
# Set BACKEND_URL to your Render public URL to enable the self-ping keep-alive
# that prevents the free dyno from sleeping (pings /health every 10 min).
# Also set up UptimeRobot as an external backup: https://uptimerobot.com
BACKEND_URL=https://your-app.onrender.com
# Per-request timeout in ms (default: 30000). Raise if you have slow PDF/image ops.
REQUEST_TIMEOUT_MS=30000
