generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum ReturnStatus {
  VERIFYING
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique
  phone        String?  @unique @db.VarChar(20)
  passwordHash String
  role         Role     @default(USER)
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  printOrders   PrintOrder[]
  reviews       Review[]
  otpCodes      OtpCode[]
  returns       Return[]
}

model RefreshToken {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  tokenHash        String
  expiresAt        DateTime
  /// Absolute hard limit: no refresh accepted after this time (10-hour session cap)
  sessionExpiresAt DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// OTP codes for email/phone-based passwordless login
model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  code      String   @db.VarChar(6)
  target    String   /// email or phone used for delivery
  type      String   @default("LOGIN") /// LOGIN | VERIFY
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([target])
}

model Book {
  id            String                   @id @default(uuid()) @db.Uuid
  title         String                   @db.VarChar(255)
  author        String                   @db.VarChar(255)
  isbn          String                   @unique
  description   String?
  price         Decimal                  @db.Decimal(10, 2)
  comparePrice  Decimal?                 @db.Decimal(10, 2)
  coverImageUrl String
  coverPublicId String
  images        BookImage[]
  categoryId    String?                  @db.Uuid
  subcategoryId String?                  @db.Uuid
  stock         Int                      @default(0)
  language      String                   @default("English")
  publication   String?
  isPrintBook        Boolean                  @default(false)
  allowStapleBinding Boolean             @default(false)
  allowSpiralBinding Boolean             @default(false)
  isOutOfStock       Boolean             @default(false)
  height        Decimal?                 @db.Decimal(10, 2) // cm
  length        Decimal?                 @db.Decimal(10, 2) // cm
  breadth       Decimal?                 @db.Decimal(10, 2) // cm
  weight        Decimal?                 @db.Decimal(10, 3) // kg
  searchVector  Unsupported("tsvector")?
  isFeatured    Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  category      Category?                @relation(fields: [categoryId],    references: [id], onDelete: SetNull)
  subcategory   Subcategory?             @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  bookCategories    BookCategory[]
  bookSubcategories BookSubcategory[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  sectionLinks  CategorySectionBook[]
  @@index([categoryId])
  @@index([subcategoryId])
}

/// Many-to-many: one book ↔ multiple categories
model BookCategory {
  bookId     String   @db.Uuid
  categoryId String   @db.Uuid
  book       Book     @relation(fields: [bookId],     references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([bookId, categoryId])
  @@index([bookId])
  @@index([categoryId])
}

/// Many-to-many: one book ↔ multiple subcategories
model BookSubcategory {
  bookId        String      @db.Uuid
  subcategoryId String      @db.Uuid
  book          Book        @relation(fields: [bookId],        references: [id], onDelete: Cascade)
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  @@id([bookId, subcategoryId])
  @@index([bookId])
  @@index([subcategoryId])
}

model BookImage {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @db.Uuid
  imageUrl  String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  @@index([bookId])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookId     String   @db.Uuid
  userId     String   @db.Uuid
  rating     Int
  title      String?
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([bookId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String @id @default(uuid()) @db.Uuid
  cartId      String @db.Uuid
  bookId      String @db.Uuid
  quantity    Int
  bindingType String @default("NONE")
  cart        Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book        Book   @relation(fields: [bookId], references: [id])
  @@unique([cartId, bookId])
  @@index([cartId])
  @@index([bookId])
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  deliveryCharge  Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal?      @db.Decimal(10, 2)
  finalAmount     Decimal?      @db.Decimal(10, 2)
  couponCode      String?
  shippingAddress Json
  paymentMethod    PaymentMethod @default(ONLINE)
  customerEmail    String?
  deliveryType     String?       @default("PAID")
  deliveryDistance Decimal?      @db.Decimal(5, 2)
  customerLatitude  Float?
  customerLongitude Float?
  /// How deliveryDistance was computed: GOOGLE_DISTANCE_MATRIX | HAVERSINE | UNAVAILABLE
  calculationMethod String?
  /// Snapshot of the store origin used for this calculation: { address, lat, lng }
  storeLocation     Json?
  // ── Shipmozo integration fields ──────────────────────────────────────────
  shipmozoOrderId      String?
  shipmozoReferenceId  String?
  awbCode              String?
  courierName          String?
  trackingUrl          String?
  labelUrl             String?
  invoiceUrl           String?
  manifestUrl          String?
  shipmozoStatus       String?   @default("NOT_CREATED")
  invoiceNumber    String?       @unique
  invoiceSent      Boolean       @default(false)
  invoiceSentAt    DateTime?
  adminSeen        Boolean       @default(false)
  /// Shipping zone, weight, and rate breakdown — populated at order time
  shippingDetails  Json?
  createdAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?
  returns        Return[]
  @@index([userId])
  @@index([awbCode])
}


model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @db.Uuid
  bookId          String  @db.Uuid
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)
  bindingType     String  @default("NONE")
  bindingExtra    Decimal @default(0) @db.Decimal(10, 2)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book            Book    @relation(fields: [bookId], references: [id])
  @@index([orderId])
  @@index([bookId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @unique @db.Uuid
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(ONLINE)
  createdAt         DateTime      @default(now())
  /// Razorpay refund id — set once a refund has been initiated for a cancelled order
  razorpayRefundId  String?
  /// Raw Razorpay refund status at initiation time: pending | processed | failed
  refundStatus      String?
  refundedAt        DateTime?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Return {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @db.Uuid
  userId    String       @db.Uuid
  email     String
  reason    String?
  status    ReturnStatus @default(VERIFYING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([orderId])
  @@index([userId])
  @@index([email])
}

model Banner {
  id              String   @id @default(uuid()) @db.Uuid
  imageUrl        String
  publicId        String
  desktopImageUrl String?
  desktopPublicId String?
  mobileImageUrl  String?
  mobilePublicId  String?
  redirectUrl     String
  title           String?
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model Coupon {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique
  discountType   String
  discountValue  Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int        @default(0)
  isActive       Boolean    @default(true)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  uses           CouponUse[]
}

model CouponUse {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  userId    String   @db.Uuid
  orderId   String   @db.Uuid
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

model PrintSettings {
  id   String @id @default(uuid()) @db.Uuid

  /// Per-page price for single-side printing when page count <= bulkThreshold
  singleSideBasePrice     Decimal @default(1.00) @db.Decimal(10, 2)
  /// Per-page price for single-side printing when page count > bulkThreshold
  singleSideBulkPrice     Decimal @default(0.50) @db.Decimal(10, 2)
  /// Per-page price for double-side printing (flat regardless of count)
  doubleSidePrice         Decimal @default(1.00) @db.Decimal(10, 2)
  /// Page count threshold above which bulk pricing kicks in
  bulkThreshold           Int     @default(20)

  /// Additional per-page charge for color printing (legacy)
  colorSurcharge          Decimal @default(3.00) @db.Decimal(10, 2)

  /// Fixed charges for binding options
  spiralExtra             Decimal @default(30) @db.Decimal(10, 2)
  staplerExtra            Decimal @default(10) @db.Decimal(10, 2)

  /// Maximum number of PDF files allowed per order (admin-configurable)
  maxPdfsPerOrder         Int     @default(20)

  /// ── Independent B&W pricing ──────────────────────────────────────────────
  bwSingleSide            Decimal @default(1.00)  @db.Decimal(10, 2)
  bwBothSideUnder20       Decimal @default(2.00)  @db.Decimal(10, 2)
  bwBothSideAbove20       Decimal @default(1.00)  @db.Decimal(10, 2)

  /// ── Independent Color pricing ────────────────────────────────────────────
  colorSingleSide         Decimal @default(8.00)  @db.Decimal(10, 2)
  colorBothSideUnder20    Decimal @default(10.00) @db.Decimal(10, 2)
  colorBothSideAbove20    Decimal @default(8.00)  @db.Decimal(10, 2)
  colorAbove99            Decimal @default(6.00)  @db.Decimal(10, 2)

  // Legacy fields kept for backward compat (unused in new pricing)
  colorPrice              Decimal @default(5.00) @db.Decimal(10, 2)
  bwPrice                 Decimal @default(1.00) @db.Decimal(10, 2)
  singleSideExtra         Decimal @default(0) @db.Decimal(10, 2)
  bothSideDiscount        Decimal @default(0) @db.Decimal(10, 2)
}

/// Individual PDF file within a print order
model PrintFile {
  id           String     @id @default(uuid()) @db.Uuid
  printOrderId String     @db.Uuid
  fileUrl      String
  filePublicId String
  /// Where this file actually lives — CLOUDINARY (legacy, pre-S3-migration) or S3.
  /// Existing rows default to CLOUDINARY since that's where they were uploaded;
  /// new uploads are written with S3 explicitly.
  storageProvider String  @default("CLOUDINARY")
  originalName String     @db.VarChar(255)
  fileSize     String     @default("") @db.VarChar(100)
  pageCount    Int        @default(0)
  /// Copies requested for this specific file (independent of other files)
  copies       Int        @default(1)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  printOrder   PrintOrder @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  @@index([printOrderId])
}

model PrintOrder {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  /// Legacy single-file URL (kept for backward compat)
  fileUrl       String        @default("")
  filePublicId  String        @default("")
  /// Where the legacy fileUrl/filePublicId above actually live — CLOUDINARY or S3.
  storageProvider String      @default("CLOUDINARY")
  colorType     String
  printSide     String
  orientation   String
  bindingType   String
  /// Total pages across all uploaded files × copies
  pageCount     Int
  /// Number of copies/sets requested
  copies        Int           @default(1)
  totalPrice    Decimal       @db.Decimal(10, 2)
  /// Estimated print time in minutes
  estimatedMinutes Int        @default(0)
  status        String        @default("PENDING")
  /// Print orders MUST be prepaid — no COD
  paymentMethod PaymentMethod @default(ONLINE)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  customerEmail   String?
  customerName    String?
  customerPhone   String?     @db.VarChar(20)
  customerAddress String?
  deliveryCharge   Decimal   @default(0) @db.Decimal(10, 2)
  deliveryType     String?   @default("PAID")
  deliveryDistance Decimal?  @db.Decimal(5, 2)
  customerLatitude  Float?
  customerLongitude Float?
  /// How deliveryDistance was computed: GOOGLE_DISTANCE_MATRIX | HAVERSINE | UNAVAILABLE
  calculationMethod String?
  /// Snapshot of the store origin used for this calculation: { address, lat, lng }
  storeLocation     Json?
  colorPrice    Decimal?      @db.Decimal(10, 2)
  bwPrice       Decimal?      @db.Decimal(10, 2)
  bindingExtra  Decimal?      @db.Decimal(10, 2)
  sideExtra     Decimal?      @db.Decimal(10, 2)
  invoiceNumber String?       @unique
  invoiceSent   Boolean       @default(false)
  invoiceSentAt DateTime?
  adminSeen     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  files         PrintFile[]
  @@index([userId])
}

model SiteSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  storeName          String   @default("Akash Book Centre")
  tagline            String   @default("")
  logoUrl            String?
  logoPublicId       String?
  logoWidth          Int      @default(120)
  logoHeight         Int      @default(40)
  spiralBindingPrice Decimal  @default(30) @db.Decimal(10, 2)
  /// Max PDF files a user can upload per print order (mirrors PrintSettings for convenience)
  maxPdfUploads      Int      @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Page {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  slug         String   @unique
  content      String
  isActive     Boolean  @default(true)
  showInFooter Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FeaturedSection {
  id     String @id @default(uuid()) @db.Uuid
  bookId String @db.Uuid
  order  Int    @default(0)
  @@index([bookId])
}

/// Product category with optional cover image
model Category {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  slug          String        @unique
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean       @default(true)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories    Subcategory[]
  books            Book[]
  bookCategories   BookCategory[]
  sections         CategorySection[]
}

/// Sub-category belonging to a Category
model Subcategory {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @db.Uuid
  name          String
  slug          String   @unique
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  books            Book[]
  bookSubcategories BookSubcategory[]
  sections         CategorySection[]
  sectionSubcategories CategorySectionSubcategory[]
  @@unique([categoryId, name])
  @@index([categoryId])
}

/// Stores the dynamic homepage section layout & per-section config

/// Dynamic homepage sections — fully configurable from admin panel
model HomepageSection {
  id            String   @id @default(uuid()) @db.Uuid
  title         String   @db.VarChar(255)
  subtitle      String?  @db.VarChar(255)
  description   String?  @db.Text
  /// 'books' | 'banner' | 'categories' | 'printCta' | 'allBooks'
  type          String   @default("books")      @db.VarChar(50)
  /// 'horizontal' | 'grid' | 'carousel'
  layoutType    String   @default("horizontal") @db.VarChar(50)
  /// 'newArrivals' | 'bestSellers' | 'featured' | 'all'
  bookFilter    String   @default("newArrivals") @db.VarChar(50)
  categoryId    String?  @db.Uuid
  subcategoryId String?  @db.Uuid
  isEnabled     Boolean  @default(true)
  order         Int      @default(0)
  /// Extra JSON settings (limit, showAll, selectedProductIds, etc.)
  config        Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([order])
  @@index([isEnabled])
}
model HomepageConfig {
  id        String   @id @default(uuid()) @db.Uuid
  /// JSON array of HomepageSection objects (type, enabled, order, config)
  sections  Json
  updatedAt DateTime @updatedAt
}

model ShippingSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  /// Master kill-switch: when false calculateShipping always returns 0
  isShippingEnabled     Boolean  @default(true)
  /// KM radius within which distance-based (per-km) pricing applies; beyond this, weight/zone-based pricing kicks in
  distanceThreshold     Float    @default(3.0)
  /// Charge per km for orders within the distanceThreshold
  perKmRate             Decimal  @default(8)   @db.Decimal(10, 2)
  /// Order value at or above which local delivery is free
  freeDeliveryThreshold Decimal  @default(199) @db.Decimal(10, 2)
  /// All-India fallback weight-based rate (₹/kg) — used when no zone or state match
  defaultKgRate         Decimal  @default(70)  @db.Decimal(10, 2)
  /// JSON array: [{ "state": "Delhi", "rate": 50 }, ...] — custom per-state overrides
  stateRates            Json     @default("[]")
  /// ── Regional shipping zone rates ──────────────────────────────────────────
  /// Delhi + NCR (Delhi, Noida, Gurugram, Faridabad, Ghaziabad, Greater Noida)
  localZoneRate         Decimal  @default(50)  @db.Decimal(10, 2)
  /// North East (Arunachal Pradesh, Assam, Manipur, Meghalaya, Mizoram, Nagaland, Tripura, Sikkim)
  northEastRate         Decimal  @default(80)  @db.Decimal(10, 2)
  /// ── Flat area charges (added on top of weight charge for beyond-threshold orders) ──
  localZoneAreaCharge   Decimal  @default(0)   @db.Decimal(10, 2)
  northEastAreaCharge   Decimal  @default(0)   @db.Decimal(10, 2)
  defaultAreaCharge     Decimal  @default(0)   @db.Decimal(10, 2)
  // ── Legacy fields (kept for backward compatibility) ──────────────────
  freeRadius            Float    @default(5.0)
  baseCharge            Decimal  @default(50) @db.Decimal(10, 2)
  perKmCharge           Decimal  @default(10) @db.Decimal(10, 2)
  maxCharge             Decimal? @db.Decimal(10, 2)
  prepaidDiscountType   String   @default("PERCENT")
  prepaidDiscountValue  Decimal  @default(5)  @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt
}

/// Admin-defined sections that appear as cards on the customer-facing Categories page
model CategorySection {
  id            String   @id @default(uuid()) @db.Uuid
  heading       String
  imageUrl      String?
  imagePublicId String?
  /// "category" = auto-resolved from a category/subcategory | "manual" = hand-picked books
  contentType   String   @default("category") @db.VarChar(20)
  categoryId    String?  @db.Uuid
  subcategoryId String?  @db.Uuid
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category?    @relation(fields: [categoryId],    references: [id], onDelete: SetNull)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  sectionBooks         CategorySectionBook[]
  sectionSubcategories CategorySectionSubcategory[]

  @@index([sortOrder])
}

/// Junction table: books manually pinned to a CategorySection
model CategorySectionBook {
  id        String          @id @default(uuid()) @db.Uuid
  sectionId String          @db.Uuid
  bookId    String          @db.Uuid
  sortOrder Int             @default(0)

  section   CategorySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  book      Book            @relation(fields: [bookId],    references: [id], onDelete: Cascade)

  @@unique([sectionId, bookId])
  @@index([sectionId])
}

/// Junction table: subcategories linked to a CategorySection (multi-subcategory support)
model CategorySectionSubcategory {
  id            String          @id @default(uuid()) @db.Uuid
  sectionId     String          @db.Uuid
  subcategoryId String          @db.Uuid

  section     CategorySection @relation(fields: [sectionId],     references: [id], onDelete: Cascade)
  subcategory Subcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subcategoryId])
  @@index([sectionId])
}
